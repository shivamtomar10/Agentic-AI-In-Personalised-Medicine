# Copy to .env. Everything has a safe default; the prototype runs fully offline.
APP_ENV=development
SEED=42

# Orchestration thresholds
SELECTIVE_REPLAN_THRESHOLD=0.3
ABSTENTION_THRESHOLD=0.6
EVIDENCE_HORIZON_YEARS=10
MAX_AGENT_INVOCATIONS=24
RUN_TIMEOUT_SECONDS=30

# Optional clinician API token. If set, clinician endpoints require header X-API-Token.
CLINICIAN_API_TOKEN=

# OPTIONAL LLM narration (off by default; rule-based core needs no LLM).
LLM_PROVIDER=ollama            # none | ollama | gemini | anthropic
LLM_LOCAL_ONLY=true          # true => refuse any cloud provider (privacy mode). Set false ONLY for synthetic data.
LLM_TEMPERATURE=0.1
LLM_SEED=42
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
GEMINI_API_KEY=
# Model ids are retired regularly (gemini-1.5-* is retired). Check Google's current list.
GEMINI_MODEL=                # set a CURRENT model id from Google's list (gemini-1.5-* is retired; 'gemini-3.8-flash' could not be verified)

# Optional Postgres (not used by the in-memory prototype)
DATABASE_URL=postgresql://cdss_admin:cdss_secure_pass@localhost:5432/cdss_longitudinal

# LLM escalation for hard cases (advisory only; needs a configured provider)
ENABLE_LLM_ESCALATION=true
LLM_ESCALATION_MARGIN=0.15
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Website and accounts (see docs/website.md)
APP_ENV=development                 # set to "production" on any server other than your own laptop
SITE_NAME=CareTrace                 # brand name shown in the header, footer and page titles
PUBLIC_URL=                         # e.g. https://care.example.org  (used in password-reset links; REQUIRED in production)
DEMO_MODE=                          # blank = on in development, off in production. Demo mode seeds demo accounts and shows their passwords on /login
CLINICIAN_INVITE_CODE=              # code clinicians need to self-register. Blank = self-registration off (use: python run.py create-clinician)
COOKIE_SECURE=                      # blank = true in production (needs HTTPS)
TRUST_PROXY=false                   # true only behind a reverse proxy you control (uses X-Forwarded-For for rate limits)
PERSIST_DATA=true                   # keep accounts, records and patient states on disk between restarts
DATABASE_PATH=                      # default data/app.db
STATE_PATH=                         # default data/patient_states.jsonl
